# Скопируй в .env и заполни. .env в git не попадает.

# Публичный IP VPN-сервера, который мониторим.
# Пока нет DDNS — задаётся здесь; когда появится DuckDNS, перейдём на dns_sd.
# В git это значение не должно попадать: репозиторий публичный.
VPN_IP=46.8.100.230

# Grafana: 127.0.0.1 — только локально/через туннель, публичный IP — извне.
# Prometheus и node-exporter всегда слушают только 127.0.0.1.
GRAFANA_BIND=127.0.0.1

# Pushgateway принимает heartbeat с VPN-сервера.
# Если Tailscale стоит на обоих — укажи здесь 100.x.y.z этого сервера.
PUSHGATEWAY_BIND=127.0.0.1

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-please

# Telegram: @BotFather -> токен, @userinfobot -> chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Алерты (обязательно) ---
# Получатель писем
ALERT_EMAIL_TO=you@example.com

# SMTP-отправитель. Grafana умеет STARTTLS, поэтому порт 587 (не 465).
# Gmail:  smtp.gmail.com:587   + пароль приложения (нужна 2FA)
# Яндекс: smtp.yandex.ru:587   + пароль приложения
# Mail.ru: smtp.mail.ru:465 — не подойдёт, Grafana не умеет implicit TLS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=пароль-приложения
SMTP_FROM=you@gmail.com
